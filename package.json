{
  "name": "job-applier-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds full-time roles worth applying to, identifies who to talk to, and drafts the outreach. Sending stays human.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "poll": "tsx --env-file-if-exists=.env src/poll.ts",
    "poll:once": "tsx --env-file-if-exists=.env src/poll.ts --once",
    "queue": "tsx --env-file-if-exists=.env src/queue.ts",
    "agent": "tsx --env-file-if-exists=.env src/agent/run.ts",
    "status": "tsx --env-file-if-exists=.env src/status.ts",
    "explain": "tsx --env-file-if-exists=.env src/explain.ts",
    "sources": "tsx --env-file-if-exists=.env src/sources/probe.ts",
    "connections": "tsx --env-file-if-exists=.env src/agent/connections-probe.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/cerebras": "^3.0.43",
    "@anthropic-ai/sdk": "^0.122.0",
    "@mastra/core": "^1.64.0",
    "@mastra/mcp": "^1.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.92",
    "better-sqlite3": "^13.0.3",
    "ollama-ai-provider-v2": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
