{
  "name": "job-applier-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds full-time roles worth applying to, identifies who to talk to, and drafts the outreach. Sending stays human.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "node": ">=22" },
  "scripts": {
    "poll": "tsx --env-file-if-exists=.env src/poll.ts",
    "poll:once": "tsx --env-file-if-exists=.env src/poll.ts --once",
    "queue": "tsx --env-file-if-exists=.env src/queue.ts",
    "status": "tsx --env-file-if-exists=.env src/status.ts",
    "explain": "tsx --env-file-if-exists=.env src/explain.ts",
    "sources": "tsx --env-file-if-exists=.env src/sources/probe.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
